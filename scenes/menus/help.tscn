[sub_resource type="GDScript" id="GDScript_qei3j"]
script/source = "extends Control

@onready var container_name = $ContainerName
@onready var text_edit = $ContainerName/VBoxContainer/TextEdit
var name_chosen = false

func _process(delta: float) -> void:
	if Input.is_action_just_pressed(\"shoot_up\") and name_chosen:
		get_tree().change_scene_to_file(\"res://scenes/main.tscn\")


func _on_accept_button_pressed():
	container_name.visible = false
	Score.set_user_id(text_edit.text)
	name_chosen = true
	
"

